#include <windows.h>
#include <commctrl.h>
#include "resource.h"

IDD_LENS DIALOGEX 0, 0, 250, 420
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    PUSHBUTTON      "<", IDC_PREV, 4, 4, 16, 14
    PUSHBUTTON      ">", IDC_NEXT, 22, 4, 16, 14
    LTEXT           "", IDC_MSGLBL, 42, 7, 200, 10, SS_LEFTNOWORDWRAP
    COMBOBOX        IDC_VIEW, 4, 21, 242, 120, CBS_DROPDOWNLIST | WS_TABSTOP
    AUTOCHECKBOX    "Follow caret", IDC_FOLLOW, 4, 37, 58, 12
    AUTOCHECKBOX    "Hide empty", IDC_HIDEEMPTY, 64, 37, 54, 12
    EDITTEXT        IDC_FILTER, 4, 52, 242, 13, ES_AUTOHSCROLL
    PUSHBUTTON      "Copy path", IDC_COPYPATH, 4, 68, 120, 14
    PUSHBUTTON      "Go to path...", IDC_GOTO, 126, 68, 120, 14
    PUSHBUTTON      "Expand all", IDC_EXPAND, 4, 84, 120, 14
    PUSHBUTTON      "Collapse all", IDC_COLLAPSE, 126, 84, 120, 14
    EDITTEXT        IDC_READOUT, 4, 102, 242, 52, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL
    CONTROL         "", IDC_TREE, "SysTreeView32", TVS_HASBUTTONS | TVS_HASLINES | TVS_LINESATROOT | TVS_SHOWSELALWAYS | TVS_INFOTIP | TVS_NOHSCROLL | WS_BORDER | WS_TABSTOP, 4, 158, 242, 242
    CONTROL         "", IDC_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP | NOT WS_VISIBLE, 4, 158, 242, 242
    LTEXT           "", IDC_STATUS, 4, 404, 242, 10, SS_LEFTNOWORDWRAP
END

IDD_INPUT DIALOGEX 0, 0, 320, 60
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "HL7Lens"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_INLABEL, 6, 6, 308, 10
    EDITTEXT        IDC_INEDIT, 6, 20, 308, 13, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK", IDOK, 220, 40, 44, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 270, 40, 44, 14
END

IDD_ABOUT DIALOGEX 0, 0, 300, 268
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About HL7Lens"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "HL7Lens for Notepad++", IDC_AB_TITLE, 10, 8, 280, 16
    LTEXT           "", IDC_AB_VER, 10, 26, 280, 10
    LTEXT           "Created by Joseph C McGinty Jr.", IDC_AB_AUTHOR, 10, 40, 280, 11
    LTEXT           "", IDC_AB_COPY, 10, 53, 280, 10
    LTEXT           "Reads HL7 v2 messages in plain language, right in the editor.", IDC_AB_TAG, 10, 68, 280, 10
    EDITTEXT        IDC_AB_TEXT, 10, 82, 280, 158, ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Buy me a coffee", IDC_AB_COFFEE, 10, 248, 76, 14
    DEFPUSHBUTTON   "OK", IDOK, 240, 248, 50, 14
END

1 VERSIONINFO
FILEVERSION 1,1,0,0
PRODUCTVERSION 1,1,0,0
FILEOS 0x40004
FILETYPE 0x2
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Joseph C McGinty Jr."
            VALUE "Author", "Created by Joseph C McGinty Jr."
            VALUE "FileDescription", "HL7Lens - HL7 v2 message decoder for Notepad++"
            VALUE "FileVersion", "1.1.0.0"
            VALUE "InternalName", "HL7Lens"
            VALUE "LegalCopyright", "Copyright (c) 2026 Joseph C McGinty Jr. GNU GPL v3. Provided as is, without warranty. Independent personal work, not associated with any organisation."
            VALUE "LegalTrademarks", "HL7 and Health Level Seven are registered trademarks of Health Level Seven International. HL7Lens is not affiliated with or endorsed by HL7 International."
            VALUE "Comments", "Works offline on the text open in the editor. Sends nothing over a network."
            VALUE "OriginalFilename", "HL7Lens.dll"
            VALUE "ProductName", "HL7Lens for Notepad++"
            VALUE "ProductVersion", "1.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
